<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Spracherkennung: Mikrofon -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Gemini API: Internet-Verbindung -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Netzwerkstatus prüfen (Cloud vs. Offline) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Paket-Sichtbarkeit für Spracherkennungs-Dienste (Wichtig ab Android 11) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.google.android.googlequicksearchbox" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SprachBruecke"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensor"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
